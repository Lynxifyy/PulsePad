    <string name="tuning_latency_disclaimer">Accessibility-only mode: expect roughly 50-120 ms depending on the device. This is not a virtual gamepad, and games that only accept gamepad input will not see these actions at all.</string>
    <string name="tuning_engine_title">Injection engine</string>
    <string name="tuning_arm_body">Mappings are replayed only while the engine is armed. Disarming stops every gesture immediately.</string>
    <string name="tuning_armed_notice">Armed. Gestures are being injected into the foreground app.</string>
    <string name="tuning_disarmed_notice">Disarmed. No gestures are being injected.</string>
    <string name="tuning_unavailable_notice">Injection is unavailable because the accessibility service is not running.</string>
    <string name="tuning_arm_failed">Injection could not be armed. Enable the accessibility service first.</string>
