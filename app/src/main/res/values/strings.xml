    <!-- Onboarding -->
    <string name="onboarding_title">Set up PulsePad</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_done">Finish</string>
    <string name="onboarding_step_welcome_title">Controller remapping without root</string>
    <string name="onboarding_step_welcome_body">PulsePad reads Bluetooth controllers and replays your mappings as touch gestures. Nothing is installed system-wide and no PC, ADB or root access is involved.</string>
    <string name="onboarding_step_bluetooth_title">Connect a controller</string>
    <string name="onboarding_step_bluetooth_body">Pair your PS4, PS5 or Xbox controller in the system Bluetooth settings, then return here. PulsePad needs permission to see and connect to it.</string>
    <string name="onboarding_grant_bluetooth">Grant Bluetooth permission</string>
    <string name="onboarding_bluetooth_granted">Bluetooth permission granted</string>
    <string name="onboarding_step_accessibility_title">Enable the accessibility service</string>
    <string name="onboarding_step_accessibility_body">Android only lets an app send touches to other apps through an accessibility service, and only you can enable it. Find PulsePad under Installed services and turn it on.</string>
    <string name="onboarding_open_accessibility">Open accessibility settings</string>
    <string name="onboarding_step_latency_title">About latency</string>
    <string name="onboarding_step_latency_body">PulsePad replays gestures, so expect roughly 50-120 ms between a button press and the effect. Games that read gamepad input directly will not respond to these gestures at all.</string>
    <string name="onboarding_step_rendering_title">Controller preview</string>
    <string name="onboarding_step_rendering_body_3d">This device supports OpenGL ES 3.0, so the studio renders the controller models in 3D.</string>
    <string name="onboarding_step_rendering_body_2d">This device does not support OpenGL ES 3.0, so the studio uses a 2D schematic. Mapping works exactly the same way.</string>
    <string name="onboarding_step_hid_title">Bluetooth HID host</string>
    <string name="onboarding_step_hid_body_available">This device exposes the Bluetooth HID host profile, so PulsePad can connect to controllers directly.</string>
    <string name="onboarding_step_hid_body_unavailable">This device restricts the Bluetooth HID host profile. PulsePad will fall back to reading bonded controllers through the standard input system.</string>
    <string name="onboarding_step_complete_title">You are ready</string>
    <string name="onboarding_step_complete_body">Open the Devices tab to connect a controller, then map its controls in the 3D Studio. Arm injection from the Tuning tab when you want mappings to apply outside PulsePad.</string>

